<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <Dialog title="{i18n>productDetails}" contentWidth="30rem">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" class="sapUiSmallMargin">
        <Label text="{i18n>name}"/>
        <Input value="{name}" required="true"/>
        <Label text="{i18n>description}"/>
        <TextArea value="{description}" rows="2" width="100%"/>
        <Label text="{i18n>sku}"/>
        <Input value="{sku}"/>
        <Label text="{i18n>stock}"/>
        <StepInput min="0" value="{stock}"/>
        <Label text="{i18n>price}"/>
        <Input value="{price}" type="Number"/>
        <Label text="{i18n>currency}"/>
        <ComboBox
          items="{path: '/Currencies', parameters: {$select: 'code,name'}}"
          selectedKey="{currency_code}">
          <core:Item key="{code}" text="{name}"/>
        </ComboBox>
      </f:SimpleForm>
    </content>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press="onSaveProduct"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press="onCancelProductDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
