<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <Dialog title="{i18n>customerDetails}" contentWidth="30rem">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" class="sapUiSmallMargin">
        <Label text="{i18n>name}"/>
        <Input value="{name}" required="true"/>
        <Label text="{i18n>email}"/>
        <Input value="{email}" type="Email"/>
        <Label text="{i18n>phone}"/>
        <Input value="{phone}"/>
        <Label text="{i18n>country}"/>
        <Input value="{country}" maxLength="3"/>
        <Label text="{i18n>city}"/>
        <Input value="{city}"/>
        <Label text="{i18n>street}"/>
        <Input value="{street}"/>
        <Label text="{i18n>postalCode}"/>
        <Input value="{postalCode}"/>
      </f:SimpleForm>
    </content>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press="onSaveCustomer"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press="onCancelCustomerDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
